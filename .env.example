# ---- Bot ----
# Get this from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---- Behaviour ----
# Comma-separated numeric Telegram user IDs allowed to use the bot (leave empty to allow anyone in private chat)
ALLOWED_USER_IDS=

# Max flow starts per user per RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_MAX_STARTS=3
RATE_LIMIT_WINDOW_SECONDS=600

# Max wrong code/password attempts before the flow is cancelled
MAX_AUTH_ATTEMPTS=3

# Seconds of inactivity before an in-progress flow auto-expires and is wiped
FLOW_TIMEOUT_SECONDS=300

# Directory for secure ephemeral temp files (must be a local, non-shared path)
SECURE_TMP_DIR=/tmp/tgsession_secure

# Logging level (never set to DEBUG in production - see README security notes)
LOG_LEVEL=INFO
